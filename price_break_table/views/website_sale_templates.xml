<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Page produit : valeur et minimum du sélecteur (server-side)
             ============================================================ -->
        <template id="website_sale_product_qty_min_attr" inherit_id="website_sale.product" priority="20">
            <xpath expr="//input[@name='add_qty']" position="attributes">
                <attribute name="t-att-min">product.get_website_min_purchase_qty() or 1</attribute>
                <attribute name="t-att-value">product.get_website_min_purchase_qty() or 1</attribute>
            </xpath>
        </template>

        <!-- ============================================================
             Page produit : tableau de prix dégressifs et minimum de commande
             (le comportement est dans static/src/js/price_break_table.js)
             ============================================================ -->
        <template id="website_sale_product_price_break" name="Product Price Break Table" inherit_id="website_sale.product">
            <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
                <t t-set="price_break_data" t-value="product.get_price_break_table_data()"/>
                <t t-set="min_purchase_qty" t-value="price_break_data.get('min_purchase_qty') or 0"/>
                <t t-set="price_break_rows" t-value="price_break_data.get('rows') or []"/>
                <t t-set="min_purchase_qty_display"
                   t-value="int(min_purchase_qty) if min_purchase_qty == int(min_purchase_qty) else min_purchase_qty"/>

                <span id="price_break_min_qty_value" style="display:none;"
                      t-att-data-min-qty="min_purchase_qty"/>

                <div id="price_break_min_qty_error" class="alert alert-warning price-break-block mt-2 mb-1"
                     style="display:none;">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    La quantité minimale de commande pour ce produit est de
                    <strong><t t-esc="min_purchase_qty_display"/></strong>
                    unité(s).
                </div>

                <div class="price-break-block">
                    <p t-if="min_purchase_qty &gt; 0" class="price-break-note text-muted mb-1 mt-3">
                        <i class="fa fa-info-circle me-1"/>
                        Quantité mini : <strong><t t-esc="min_purchase_qty_display"/></strong>
                    </p>

                    <div t-if="len(price_break_rows) &gt; 1" class="table-responsive price-break-table-container">
                        <table class="table table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th>Quantité</th>
                                    <th>Prix unitaire</th>
                                    <th>Remise</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="price_break_rows" t-as="row"
                                    class="price-break-row"
                                    t-att-data-qty="row['min_quantity']">
                                    <td><t t-esc="row['quantity_display']"/></td>
                                    <td><t t-esc="row['price_formatted']"/></td>
                                    <td class="price-break-discount">
                                        <t t-if="row['discount_display']"><t t-esc="row['discount_display']"/></t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </xpath>
        </template>

        <!-- ============================================================
             Pages de liste (boutique, catégorie, snippets) : annonce du
             meilleur tarif dégressif à la place du prix unitaire
             ============================================================ -->
        <template id="products_item_price_break_from" inherit_id="website_sale.products_item"
                  name="Prix dégressif « à partir de » sur les cartes produit">
            <xpath expr="//div[hasclass('product_price')]" position="before">
                <t t-set="price_break_from" t-value="product.get_price_break_from_price()"/>
            </xpath>

            <!-- Le bloc de prix standard cède la place quand un palier est à annoncer. -->
            <xpath expr="//div[hasclass('product_price')]" position="attributes">
                <attribute name="t-if">not price_break_from</attribute>
            </xpath>

            <xpath expr="//div[hasclass('product_price')]" position="after">
                <div t-if="price_break_from" class="product_price price-break-from"
                     itemprop="offers" itemscope="itemscope" itemtype="http://schema.org/Offer">
                    <span class="price-break-from-prefix small text-muted">À partir de</span>
                    <span class="h6 mb-0" t-esc="price_break_from['price_formatted']"/>
                    <span class="price-break-from-qty d-block small text-muted"
                          t-esc="price_break_from['quantity_label']"/>
                    <span itemprop="price" style="display:none;" t-esc="price_break_from['price']"/>
                    <span itemprop="priceCurrency" style="display:none;"
                          t-esc="price_break_from['currency_name']"/>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
