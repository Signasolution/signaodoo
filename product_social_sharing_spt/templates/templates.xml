<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="share_icons_product" inherit_id="website_sale.product" active="True"  name="Enable product social sharing">
        <xpath expr="//div[@id='o_product_terms_and_share']" position="before">
        <div t-if="website.is_share" >
            <script src="https://static.addtoany.com/menu/page.js"></script>
                <div class="o_sharing_links pro-link-share">
                <label style='color:#714B67;'>Share Via: </label>
                </div>
                <div t-if="website.dynamic_share"> 
                   <div class="a2a_kit a2a_kit_size_32 a2a_default_style">
                    <a class="a2a_button_facebook"></a>
                        <a class="a2a_button_telegram"></a>
                        <a class="a2a_button_pinterest"></a>
                        <a class="a2a_dd" href="https://www.addtoany.com/share"></a>
                    </div>
                    <script src="https://static.addtoany.com/menu/page.js"></script>
                </div>
                <div t-if="not website.dynamic_share">

                    <div class="a2a_kit a2a_kit_size_32 a2a_default_style">
                        <a class="a2a_button_facebook" target="_blank" href="/#facebook" rel="nofollow noopener" t-if="website.fb_visible">
                            <span class="a2a_label">Facebook</span>
                        </a>
                        <a class="a2a_button_twitter" target="_blank" href="/#twitter" rel="nofollow noopener" t-if="website.twitter_visible">
                            <span class="a2a_label">Twitter</span>
                        </a>
                        <a class="a2a_button_email" target="_blank" href="/#email" rel="nofollow noopener" t-if="website.email_visible">
                            <span class="a2a_label">Email</span>
                        </a>
                        <a class="a2a_button_google_gmail" target="_blank" href="/#google_gmail" rel="nofollow noopener" t-if="website.gmail_visible">
                            <span class="a2a_label">Gmail</span>
                        </a>
                        <a class="a2a_button_whatsapp" target="_blank" href="/#whatsapp" rel="nofollow noopener" t-if="website.whatsApp_visible">
                            <span class="a2a_label">WhatsApp</span>
                        </a>
                        <a class="a2a_button_telegram" target="_blank" href="/#telegram" rel="nofollow noopener" t-if="website.telegram_visible">
                            <span class="a2a_label">Telegram</span>
                        </a>
                        <a class="a2a_button_pocket" target="_blank" href="/#pocket" rel="nofollow noopener" t-if="website.pocket_visible">
                            <span class="a2a_label">Pocket</span>
                        </a>
                        <a class="a2a_button_pinterest" target="_blank" href="/#pinterest" rel="nofollow noopener" t-if="website.pinterest_visible">
                            <span class="a2a_label">Pinterest</span>
                        </a>
                        <a class="a2a_button_reddit" target="_blank" href="/#reddit" rel="nofollow noopener" t-if="website.reddit_visible">
                            <span class="a2a_label">Reddit</span>
                        </a>
                        <a class="a2a_button_linkedin" target="_blank" href="/#linkedin" rel="nofollow noopener" t-if="website.linkedin_visible">
                            <span class="a2a_label">LinkedIn</span>
                        </a>
                        <a class="a2a_button_flipboard" target="_blank" href="/#flipboard" rel="nofollow noopener" t-if="website.flipboard_visible">
                            <span class="a2a_label">Flipboard</span>
                        </a>
                        <a class="a2a_button_facebook_messenger" target="_blank" href="/#facebook_messenger" rel="nofollow noopener" t-if="website.fbm_visible">
                            <span class="a2a_label">Facebook Messenger</span>
                        </a>
                        <a class="a2a_button_line" target="_blank" href="/#line" rel="nofollow noopener" t-if="website.line_visible">
                            <span class="a2a_label">Line</span>
                        </a>
                        <a class="a2a_button_viber" target="_blank" href="/#viber" rel="nofollow noopener" t-if="website.viber_visible">
                            <span class="a2a_label">Viber</span>
                        </a>
                        <a class="a2a_button_wechat" target="_blank" href="/#wechat" rel="nofollow noopener" t-if="website.wechat_visible">
                            <span class="a2a_label">WeChat</span>
                        </a>
                        <a class="a2a_button_sms" target="_blank" href="/#sms" rel="nofollow noopener" t-if="website.sms_visible">
                            <span class="a2a_label">SMS</span>
                        </a>
                        <a class="a2a_button_skype" target="_blank" href="/#skype" rel="nofollow noopener" t-if="website.skype_visible">
                            <span class="a2a_label">Skype</span>
                        </a>
                        <a class="a2a_button_copy_link" target="" href="#copy_link" rel="nofollow noopener" t-if="website.copylink_visible">
                            <span class="a2a_label">Copy Link</span>
                        </a>
                        <a class="a2a_button_evernote" target="_blank" href="/#evernote" rel="nofollow noopener" t-if="website.evernote_visible">
                            <span class="a2a_label">Evernote</span>
                        </a>
                        <div style="clear: both;"></div>
                    </div>
                </div>
       </div>
        </xpath>
    </template>
    <template id="product_share_buttons" inherit_id="website_sale.product" active="True" name="Share Buttons" priority="22">
    <xpath expr="//div[@id='o_product_terms_and_share']/div[@data-snippet='s_share']" position="replace">
        
    </xpath>
</template>

</odoo>